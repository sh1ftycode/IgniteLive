# Domain pointing at this server (an A/AAAA record). Caddy gets the HTTPS certificate.
IGNITE_DOMAIN=ignite.example.com

# YouTube Data API v3 key: enables "!sr song - artist" search. Links work without it.
IGNITE_YOUTUBE_KEY=

# Optional encryption key for saved stream keys (generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Leave empty to auto-generate one inside the data volume.
IGNITE_SECRET=
